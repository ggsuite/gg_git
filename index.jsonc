{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "gg_git",

  // 1-2 sentence summary about this repo.
  "summary": "Git helpers: repository checks and commands (commit, push state, branches, tags, fetch), retry of git network commands, ssh host keys of git remotes, and test helpers that build real git repos.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "git state and commands: IsCommitted, IsPushed, Commit, Fetch, branches, tags",
    "git transport: GitRetry for dropped connections, SshHostKeys for unknown hosts",
    "test helpers: real and cached git repos for tests",
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "gg_process": "defaultProcessRunner of every git call",
      "gg_args": "DirCommand base of the commands",
      "gg_status_printer": "progress output",
      "gg_console_colors": "colored output",
      "gg_log": "GgLog",
      "gg_hash": "hash of the last changes",
      "gg_is_github": "detects runs on GitHub",
    },

    // "<repo-b>": "why / API"
    "usedBy": {
      "gg_multi_workspace": "clone, ls-remote, GitRetry, SshHostKeys",
      "gg_multi_core": "git state, branches, remotes",
      "gg_multi_commit": "git state, branches",
      "gg_multi_do_publish": "git state, branches",
      "gg_one_core": "git state: IsCommitted, IsPushed, HeadMessage, LocalBranch, CommitCount",
      "gg_one_commit": "git state: LocalBranch, IsPushed, UpstreamBranch",
    },
  },
}
